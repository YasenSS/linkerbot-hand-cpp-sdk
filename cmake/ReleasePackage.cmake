# Keep package provenance with the installed library, including subdirectory builds.
set(LINKERBOT_HAND_SOURCE_REVISION "" CACHE STRING "Full hand source commit for exported sources")
set(LINKERBOT_HAND_BUILD_IMAGE "" CACHE STRING "Build image identity, preferably an immutable digest")
option(LINKERBOT_HAND_RELEASE_BUILD "Require clean, uninstrumented release inputs" OFF)
set(_hand_revision "${LINKERBOT_HAND_SOURCE_REVISION}")
set(_hand_dirty false)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE _hand_git_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_hand_revision AND NOT _hand_revision STREQUAL _hand_git_revision)
        message(FATAL_ERROR "Provided source revision differs from checked-out HEAD")
    endif()
    set(_hand_revision "${_hand_git_revision}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" status --porcelain --untracked-files=normal
        OUTPUT_VARIABLE _hand_status OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_hand_status)
        set(_hand_dirty true)
    endif()
endif()
if(NOT _hand_revision)
    set(_hand_revision unknown)
endif()
set(_hand_instrumented false)
if(LINKERBOT_COMM_ENABLE_COVERAGE OR "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_DEBUG} ${CMAKE_CXX_FLAGS_RELEASE}" MATCHES "(--coverage|[-/]fsanitize[= ])")
    set(_hand_instrumented true)
endif()
if(LINKERBOT_HAND_RELEASE_BUILD)
    string(LENGTH "${_hand_revision}" _hand_revision_length)
    if(_hand_dirty OR NOT _hand_revision_length EQUAL 40 OR NOT _hand_revision MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Release builds require a clean source tree and full source SHA")
    endif()
    if(_hand_instrumented)
        message(FATAL_ERROR "Release builds cannot contain coverage or sanitizer instrumentation")
    endif()
endif()
set_property(TARGET linkerbot-cpp-sdk PROPERTY LINKERBOT_HAND_SOURCE_REVISION "${_hand_revision}")
set_property(TARGET linkerbot-cpp-sdk APPEND PROPERTY EXPORT_PROPERTIES LINKERBOT_HAND_SOURCE_REVISION)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _hand_arch)
if(_hand_arch MATCHES "^(amd64|x86_64)$")
    set(_hand_arch x86_64)
elseif(_hand_arch MATCHES "^(arm64|aarch64)$")
    set(_hand_arch aarch64)
endif()
if(WIN32)
    # Generator/compiler target information takes precedence over the host CPU.
    string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _hand_windows_arch)
    if(NOT _hand_windows_arch)
        string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" _hand_windows_arch)
    endif()
    if(_hand_windows_arch MATCHES "^(x64|amd64)$")
        set(_hand_arch x64)
    elseif(_hand_windows_arch MATCHES "^(arm64|aarch64)$")
        set(_hand_arch ARM64)
    elseif(_hand_windows_arch MATCHES "^(win32|x86)$")
        set(_hand_arch x86)
    else()
        set(_hand_arch unknown)
    endif()
endif()
set(_hand_distro "${CMAKE_SYSTEM_NAME}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING AND EXISTS /etc/os-release)
    file(STRINGS /etc/os-release _hand_os_id REGEX "^ID=")
    file(STRINGS /etc/os-release _hand_os_version REGEX "^VERSION_ID=")
    string(REGEX REPLACE "^ID=\"?([^\"]*)\"?$" "\\1" _hand_os_id "${_hand_os_id}")
    string(REGEX REPLACE "^VERSION_ID=\"?([^\"]*)\"?$" "\\1" _hand_os_version "${_hand_os_version}")
    set(_hand_distro "${_hand_os_id}${_hand_os_version}")
endif()
# Probe headers with the effective flags of each configuration. Compiler names
# and global flags alone do not identify the selected C++ standard library.
include(CheckCXXSourceCompiles)
function(_hand_probe_stdlib configuration output_library output_abi)
    string(TOUPPER "${configuration}" config_upper)
    set(CMAKE_TRY_COMPILE_CONFIGURATION "${configuration}")
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    set(CMAKE_REQUIRED_QUIET TRUE)
    # Do not inherit unrelated check requirements from a parent project.
    set(CMAKE_REQUIRED_FLAGS "")
    set(CMAKE_REQUIRED_DEFINITIONS "")
    set(CMAKE_REQUIRED_INCLUDES "")
    set(CMAKE_REQUIRED_LIBRARIES "")
    set(CMAKE_REQUIRED_LINK_OPTIONS "")
    # Hash flags into the check cache key so reconfiguration cannot reuse stale
    # results after changing a configuration's -stdlib or dual ABI definition.
    string(SHA256 probe_key "${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_STANDARD};${configuration};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_${config_upper}};${CMAKE_SYSROOT};${CMAKE_CXX_COMPILER_TARGET}")
    set(library unknown)
    set(abi unknown)
    foreach(candidate libcxx libstdcxx msvc)
        if(candidate STREQUAL libcxx)
            set(macro _LIBCPP_VERSION)
        elseif(candidate STREQUAL libstdcxx)
            set(macro __GLIBCXX__)
        else()
            set(macro _MSVC_STL_VERSION)
        endif()
        set(check "_hand_${probe_key}_${candidate}")
        check_cxx_source_compiles("#include <cstddef>\n#ifndef ${macro}\n#error standard library mismatch\n#endif\nint main() { return 0; }" ${check})
        if(${check})
            set(library "${candidate}")
            break()
        endif()
    endforeach()
    if(library STREQUAL libstdcxx)
        foreach(value 1 0)
            set(check "_hand_${probe_key}_abi${value}")
            check_cxx_source_compiles("#include <string>\n#if !defined(_GLIBCXX_USE_CXX11_ABI) || _GLIBCXX_USE_CXX11_ABI != ${value}\n#error dual ABI mismatch\n#endif\nint main() { return 0; }" ${check})
            if(${check})
                set(abi "${value}")
                break()
            endif()
        endforeach()
    endif()
    set(${output_library} "${library}" PARENT_SCOPE)
    set(${output_abi} "${abi}" PARENT_SCOPE)
endfunction()
if(CMAKE_CONFIGURATION_TYPES)
    set(_hand_configurations "${CMAKE_CONFIGURATION_TYPES}")
elseif(CMAKE_BUILD_TYPE)
    set(_hand_configurations "${CMAKE_BUILD_TYPE}")
else()
    set(_hand_configurations "NOCONFIG")
endif()
set(_hand_stdlib "")
set(_hand_dual_abi "")
set(_hand_stdlib_identity "")
foreach(_hand_configuration IN LISTS _hand_configurations)
    if(_hand_configuration STREQUAL "NOCONFIG")
        set(_hand_configuration "")
    endif()
    _hand_probe_stdlib("${_hand_configuration}" _hand_config_stdlib _hand_config_abi)
    set(_hand_config_identity "${_hand_config_stdlib}")
    if(_hand_config_stdlib STREQUAL "libstdcxx")
        string(APPEND _hand_config_identity "-abi${_hand_config_abi}")
    endif()
    string(APPEND _hand_stdlib "$<$<CONFIG:${_hand_configuration}>:${_hand_config_stdlib}>")
    string(APPEND _hand_dual_abi "$<$<CONFIG:${_hand_configuration}>:${_hand_config_abi}>")
    string(APPEND _hand_stdlib_identity "$<$<CONFIG:${_hand_configuration}>:${_hand_config_identity}>")
endforeach()
# Escape configurable strings before embedding them in JSON.
function(_hand_json_escape input output)
    string(REPLACE "\\" "\\\\" value "${input}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
_hand_json_escape("${LINKERBOT_HAND_BUILD_IMAGE}" _hand_image_json)
_hand_json_escape("${_hand_distro}" _hand_distro_json)
_hand_json_escape("${_hand_revision}" _hand_revision_json)
get_target_property(_hand_comm_revision linkerbot::comm LINKERBOT_COMM_SOURCE_REVISION)
if(NOT _hand_comm_revision)
    set(_hand_comm_revision unknown)
endif()
_hand_json_escape("${_hand_comm_revision}" _hand_comm_revision_json)
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/release/$<CONFIG>/build-info.json" CONTENT
"{\n  \"schema_version\": 1,\n  \"package\": \"linkerbot-hand-cpp\",\n  \"version\": \"${PROJECT_VERSION}\",\n  \"hand_sha\": \"${_hand_revision_json}\",\n  \"comm_sha\": \"${_hand_comm_revision_json}\",\n  \"source_dirty\": ${_hand_dirty},\n  \"system\": \"${CMAKE_SYSTEM_NAME}\",\n  \"architecture\": \"${_hand_arch}\",\n  \"distribution\": \"${_hand_distro_json}\",\n  \"compiler\": \"${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\",\n  \"standard_library\": \"${_hand_stdlib}\",\n  \"libstdcxx_dual_abi\": \"${_hand_dual_abi}\",\n  \"cxx_standard\": 17,\n  \"pic\": $<IF:$<BOOL:$<TARGET_PROPERTY:linkerbot-cpp-sdk,POSITION_INDEPENDENT_CODE>>,true,false>,\n  \"instrumented\": ${_hand_instrumented},\n  \"build_image\": \"${_hand_image_json}\",\n  \"toolset\": \"${MSVC_TOOLSET_VERSION}\",\n  \"configuration\": \"$<CONFIG>\",\n  \"runtime\": \"$<IF:$<BOOL:${MSVC}>,$<IF:$<CONFIG:Debug>,MDd,MD>,platform-default>\"\n}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/release/$<CONFIG>/build-info.json"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/linkerbot-hand-cpp)

if(LINKERBOT_IS_TOP_LEVEL)
    set(CPACK_PACKAGE_NAME linkerbot-hand-cpp)
    set(CPACK_PACKAGE_VENDOR LinkerBot)
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
    set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE")
    set(CPACK_PACKAGE_CHECKSUM SHA256)
    if(WIN32)
        set(CPACK_GENERATOR ZIP)
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/WindowsCPack.cmake.in"
            "${CMAKE_CURRENT_BINARY_DIR}/WindowsCPack.cmake" @ONLY)
        set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/WindowsCPack.cmake")
    else()
        set(CPACK_GENERATOR TGZ)
        # CPack evaluates this project config after -C has selected the actual
        # configuration. Generator expressions are resolved by file(GENERATE),
        # not left in CPackConfig.cmake or guessed from CMAKE_BUILD_TYPE.
        file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/CPackIdentity-$<CONFIG>.cmake" CONTENT
            "set(CPACK_PACKAGE_FILE_NAME \"linkerbot-hand-cpp-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${_hand_arch}-${_hand_distro}-${CMAKE_CXX_COMPILER_ID}${CMAKE_CXX_COMPILER_VERSION}-${_hand_stdlib_identity}-$<CONFIG>\")\n")
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/PlatformCPack.cmake.in"
            "${CMAKE_CURRENT_BINARY_DIR}/PlatformCPack.cmake" @ONLY)
        set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/PlatformCPack.cmake")
    endif()
endif()
