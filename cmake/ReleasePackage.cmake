set(LINKERBOT_HAND_SOURCE_REVISION "" CACHE STRING "Full hand source commit for exported sources")
set(_hand_revision "${LINKERBOT_HAND_SOURCE_REVISION}")
set(_hand_dirty false)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git")
    if(NOT _hand_revision)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse HEAD
            OUTPUT_VARIABLE _hand_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" diff --quiet HEAD
        RESULT_VARIABLE _hand_status)
    if(NOT _hand_status EQUAL 0)
        set(_hand_dirty true)
    endif()
endif()
if(NOT _hand_revision)
    set(_hand_revision unknown)
endif()
get_target_property(_comm_revision linkerbot::comm LINKERBOT_COMM_SOURCE_REVISION)
if(NOT _comm_revision)
    set(_comm_revision unknown)
endif()
set(_hand_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(_hand_arch x64)
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/release/$<CONFIG>/build-info.json" CONTENT
"{\n  \"package\": \"linkerbot-hand-cpp\",\n  \"version\": \"${PROJECT_VERSION}\",\n  \"hand_sha\": \"${_hand_revision}\",\n  \"comm_sha\": \"${_comm_revision}\",\n  \"source_dirty\": ${_hand_dirty},\n  \"system\": \"${CMAKE_SYSTEM_NAME}\",\n  \"architecture\": \"${_hand_arch}\",\n  \"compiler\": \"${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\",\n  \"toolset\": \"${MSVC_TOOLSET_VERSION}\",\n  \"configuration\": \"$<CONFIG>\",\n  \"runtime\": \"$<IF:$<BOOL:${MSVC}>,$<IF:$<CONFIG:Debug>,MDd,MD>,platform-default>\"\n}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/release/$<CONFIG>/build-info.json"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/linkerbot-hand-cpp)
