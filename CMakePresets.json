{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "source",
            "displayName": "Release SDK (source transport)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/source",
            "cacheVariables": {
                "LINKERBOT_COMM_PROVIDER": "SOURCE",
                "LINKERBOT_BUILD_TESTS": "OFF",
                "LINKERBOT_BUILD_TOOLS": "OFF",
                "LINKERBOT_BUILD_EXAMPLES": "OFF",
                "LINKERBOT_ALLOW_DEPENDENCY_DOWNLOADS": "OFF"
            }
        },
        {
            "name": "prebuilt",
            "displayName": "Release SDK (prebuilt transport)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/prebuilt",
            "cacheVariables": {
                "LINKERBOT_COMM_PROVIDER": "PREBUILT",
                "LINKERBOT_BUILD_TESTS": "OFF",
                "LINKERBOT_BUILD_TOOLS": "OFF",
                "LINKERBOT_BUILD_EXAMPLES": "OFF",
                "LINKERBOT_ALLOW_DEPENDENCY_DOWNLOADS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "source",
            "configurePreset": "source"
        },
        {
            "name": "prebuilt",
            "configurePreset": "prebuilt"
        }
    ]
}
